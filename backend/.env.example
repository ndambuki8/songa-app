# Songa backend configuration. Copy to backend/.env (git-ignored), fill it in, then from backend/:
#   modal secret create songa-secrets --from-dotenv .env --force
#   modal deploy modal_app.py
# Re-run both commands after changing anything in the "runtime" sections.

# ============================================================================================================
# RUNTIME: read by the deployed containers from the songa-secrets Modal secret
# ============================================================================================================

# --- Access ---------------------------------------------------------------------------------------------------
# Shared bearer token. Use the same value for EXPO_PUBLIC_SONGA_API_KEY in mobile/.env.
SONGA_API_KEY=change-me-to-a-long-random-string
# Development only: serve requests without a key when SONGA_API_KEY is empty. Never enable in production.
SONGA_ALLOW_UNAUTHENTICATED=false
# Comma-separated browser origins allowed by CORS (only needed for the Expo web build).
SONGA_CORS_ORIGINS=

# --- Meta Model API (https://dev.meta.ai/docs/api-reference/). One key covers every model below. -----------
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MEDIA_TIMEOUT_S=60

# --- Muse Wonder: Speak translation, Look answers, Journal diary, Anchor cards ----------------------------------
MUSE_MODEL_ID=muse-wonder-1.0
MUSE_REASONING_EFFORT=low
# Speak only: "minimal" cuts the translation step from ~3.5 s to ~2.2 s. Empty = use MUSE_REASONING_EFFORT.
SPEAK_REASONING_EFFORT=minimal
MUSE_JSON_MODE=true
MUSE_TIMEOUT_S=40

# --- Muse Voice Transcribe: speech-to-text for Speak and Journal voice memos -----------------------------------
TRANSCRIBE_MODEL_ID=muse-voice-transcribe-1.0

# --- Segmentation (Look) --------------------------------------------------------------------------------------
# "meta"  = hosted SAM 3.1 on the Meta Model API (default, no GPU).
# "modal" = Songa's own SAM 3 on a Modal GPU (class SamGpu). Hosted SAM still answers while the GPU boots.
SAM_BACKEND=meta
SAM_SCORE_THRESHOLD=0.35
# Hosted model id, used when SAM_BACKEND=meta and as the fallback when SAM_BACKEND=modal.
SAM_MODEL_ID=sam-3.1
# Self-hosted only: Hugging Face checkpoint (transformers format) and a token whose account has been granted
# access to it on huggingface.co.
SAM_LOCAL_MODEL_ID=facebook/sam3
HF_TOKEN=

# --- Look: "Where am I?" grounding ---------------------------------------------------------------------------
# Email or URL sent in the User-Agent for Wikipedia nearby-place lookups. Wikimedia rejects requests without
# contact details. Empty = the project repository URL.
SONGA_CONTACT=

# --- Limits (defaults shown) ------------------------------------------------------------------------------------
SONGA_MAX_AUDIO_BYTES=12582912
SONGA_MAX_IMAGE_BYTES=8388608
SONGA_MAX_LOGBOOK_ENTRIES=80
SONGA_IMAGE_CACHE_TTL_S=1800

# ============================================================================================================
# DEPLOY TIME: read by `modal deploy` from your shell, NOT from the secret. Set them in the shell when deploying,
# for example in PowerShell:  $env:SONGA_WARM="1"; modal deploy modal_app.py
# Listed here for reference only; values in this file have no effect on them.
# ============================================================================================================
# SONGA_WARM=0               # 1 keeps one gateway container always on (demos)
# SONGA_SCALEDOWN_S=300      # seconds an idle gateway container stays up
# SONGA_SAM_GPU=L4,A10       # GPU preference order for SamGpu; "L4" never uses anything else
# SONGA_SAM_SCALEDOWN_S=180  # seconds an idle GPU stays up (billed while up)
# SONGA_SAM_SNAPSHOT=1       # GPU memory snapshots: ~6 s GPU start instead of ~26 s
# SONGA_SAM_WARM=0           # 1 keeps one GPU always on (~$19/day on an L4)
