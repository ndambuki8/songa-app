# Values for the Modal secret. From the backend/ directory, create it with:
#   modal secret create songa-secrets --from-dotenv .env --force
# (copy this file to backend/.env first; it is git-ignored)

# Shared bearer token. Use the same value for EXPO_PUBLIC_SONGA_API_KEY in mobile/.env.local.
SONGA_API_KEY=change-me-to-a-long-random-string

# Meta Model API (https://dev.meta.ai/docs/api-reference/). One key covers every model below.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Muse Wonder: intent bridging, menu/sign analysis and itinerary compilation.
MUSE_MODEL_ID=muse-wonder-1.0
MUSE_REASONING_EFFORT=low

# SAM 3.1: scene segmentation and tap-to-isolate. Detections below the threshold are dropped.
SAM_MODEL_ID=sam-3.1
SAM_SCORE_THRESHOLD=0.35

# Muse Voice Transcribe: speech-to-text for the dialogue bridge and voice memos.
TRANSCRIBE_MODEL_ID=muse-voice-transcribe-1.0
