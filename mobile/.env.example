# Copy to mobile/.env (git-ignored) after `modal deploy` prints the gateway URL. Restart `npx expo start` after
# editing: Expo inlines EXPO_PUBLIC_* values into the bundle at build time.
#
# Note: anything prefixed EXPO_PUBLIC_ ships inside the app and can be read by anyone who unpacks a build.
# Use a key you can rotate, and replace it with per-device auth before a public release.

# Gateway URL printed by `modal deploy`, no trailing slash.
EXPO_PUBLIC_SONGA_API_URL=https://<your-workspace>--songa-gateway.us-east.modal.run

# Same value as SONGA_API_KEY in the songa-secrets Modal secret.
EXPO_PUBLIC_SONGA_API_KEY=<same value as SONGA_API_KEY>
